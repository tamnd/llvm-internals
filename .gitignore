# Build output
/build/
/site/
/.venv/
__pycache__/
*.pyc
# setuptools leftovers from building the toolkit as a wheel
build/lib/
*.egg-info/

# The toolchain tarballs a reader downloads and CI publishes. Large, and every
# one of them is reproducible from the pin plus a recorded cmake line.
/toolchains/
*.tar.xz
*.tar.zst

# LLVM build trees, for anyone working at E1 inside a checkout
/llvm-project/
/build-*/

# Notebook execution leftovers. The committed .ipynb files are generated by
# build.py and are the only notebooks that belong in git.
.ipynb_checkpoints/
/notebooks/**/*.nbconvert.ipynb

.DS_Store

# build.py run --output-dir
.build/

# Tool caches
.pytest_cache/
