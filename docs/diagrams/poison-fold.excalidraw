      "id": "src-note",
      "type": "text",
      "x": 60,
      "y": 424,
      "width": 436.8,
      "height": 32.5,
      "text": "select only reads the arm the condition picked.\nThe condition is false, so the poison arm is never read.",
      "originalText": "select only reads the arm the condition picked.\nThe condition is false, so the poison arm is never read.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25
    },
    {
