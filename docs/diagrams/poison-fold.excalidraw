      "id": "rule",
      "type": "text",
      "x": 60,
      "y": 616,
      "width": 826.8,
      "height": 48.75,
      "text": "A rewrite is allowed to take a poison result and make it defined. It is never allowed to go the other way.\nThat is the whole rule, and it is why LLVM's own InstCombine refuses this fold unless it can prove the\narm it is about to read was never going to be poison.",
      "originalText": "A rewrite is allowed to take a poison result and make it defined. It is never allowed to go the other way.\nThat is the whole rule, and it is why LLVM's own InstCombine refuses this fold unless it can prove the\narm it is about to read was never going to be poison.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25
    }
